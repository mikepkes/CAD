{
  "name": "openscad-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Local-first, browser-based parametric CAD: command-driven document, PlaneGCS constraint solver, renderer-agnostic core, built for CNC/3D-print-ready geometry",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/third-party-licenses.mjs && tsc --noEmit && vite build",
    "licenses": "node scripts/third-party-licenses.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p mcp/tsconfig.json",
    "mcp:build": "esbuild mcp/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-mcp/server.mjs",
    "mcp": "npm run mcp:build && node dist-mcp/server.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@salusoft89/planegcs": "^1.3.0",
    "@tauri-apps/api": "^2.12.4",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "rhino3dm": "^8.35.0",
    "robust-predicates": "^3.0.3",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
